# KebabClient example config. Copy to `.env` for local dev overrides.
# `.env` is git-ignored and NEVER bundled into the packaged .exe
# (see package.json -> build.files whitelist). Real environment
# variables always win over `.env` values.
#
# IMPORTANT: `.env` must NEVER contain secrets (no tokens, no passwords,
# no client secrets). Only public, non-sensitive overrides below.

# Discord application ID for Rich Presence. Public ID only, not a secret.
# Empty = built-in default.
DISCORD_CLIENT_ID=

# Custom data directory (absolute path). Empty = OS default.
KEBAB_DATA_DIR=

# Force Discord Rich Presence language. Empty = follow app settings.
# Allowed: de, en
KEBAB_LANG=
