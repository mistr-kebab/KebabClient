{
  "name": "kebabclient",
  "version": "0.1.9",
  "description": "Minimal Electron Minecraft launcher (MVP): Microsoft auth, 26.1.2 instance, Modrinth mods, skins/capes.",
  "license": "MIT",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win portable",
    "dist:setup": "electron-builder --win nsis",
    "dist:publish": "electron-builder --win nsis portable --publish never"
  },
  "build": {
    "appId": "com.kebabclient.launcher",
    "productName": "KebabClient",
    "files": [
      "main/**/*",
      "preload/**/*",
      "renderer/**/*",
      "package.json",
      ".env"
    ],
    "win": {
      "icon": "renderer/assets/icon.ico",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "KebabClient-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "KebabClient-Setup-${version}.exe",
      "shortcutName": "KebabClient",
      "uninstallDisplayName": "KebabClient",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "de_DE",
        "en_US"
      ],
      "language": "1031",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": "Games",
      "packElevateHelper": true
    },
    "publish": {
      "provider": "generic",
      "url": "https://kebabdev.de/static/dl/"
    }
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.9"
  }
}
